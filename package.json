{
  "name": "@korial29/tiny-fps",
  "description": "Tiny multiplayer first-person rooftop game for the browser: raw WebGL, zero runtime dependencies, WebSocket or same-browser multi-tab play.",
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/client/index.d.ts",
      "default": "./dist/index.js"
    },
    "./local": {
      "types": "./dist/types/local/index.d.ts",
      "default": "./dist/local.js"
    },
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "default": "./dist/server.js"
    },
    "./room": {
      "types": "./dist/types/room/index.d.ts",
      "default": "./dist/room.js"
    }
  },
  "bin": {
    "tiny-fps-server": "dist/cli.js"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/korial29/tiny-fps.git"
  },
  "homepage": "https://korial29.github.io/tiny-fps/",
  "keywords": [
    "fps",
    "game",
    "browser-game",
    "html5-game",
    "webgl",
    "multiplayer",
    "realtime",
    "websocket",
    "broadcastchannel",
    "typescript",
    "zero-dependency",
    "js13k"
  ],
  "author": "Ludovic Dupont <ludovic.dupont29@gmail.com>",
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "scripts": {
    "start": "vite demo --config vite.config.ts",
    "dev:server": "tsx watch src/server/cli.ts",
    "build": "rm -rf dist && vite build && BUILD_LOCAL=true vite build && BUILD_SERVER=true vite build && tsc -p tsconfig.build.json",
    "build:demo": "BUILD_DEMO=true vite build",
    "size": "node scripts/size.mjs",
    "lint:format": "oxfmt --check \"**/*.{js,mjs,ts}\"",
    "lint:oxlint": "oxlint --deny-warnings",
    "lint:tsc": "tsc --noEmit",
    "lint": "npm run lint:format && npm run lint:oxlint && npm run lint:tsc",
    "format": "oxfmt \"**/*.{js,mjs,ts}\" && oxlint --fix",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --maxWorkers=100% --passWithNoTests",
    "botmatch": "BOTMATCH=${BOTMATCH:-24} vitest run src/shared/botmatch.test.ts",
    "test:durations": "vitest run --reporter=json --outputFile=node_modules/.cache/vitest-report.json && node scripts/durations.mjs node_modules/.cache/vitest-report.json",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "terser": "^5.51.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
